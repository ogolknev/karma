{
  "name": "karma",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "generate:migrations": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "test:generate:migrations": "drizzle-kit generate --config=test.drizzle.config.ts",
    "test:migrate": "drizzle-kit migrate --config=test.drizzle.config.ts",
    "test:push": "drizzle-kit push --config=test.drizzle.config.ts"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.4",
    "pg": "^8.16.3",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}